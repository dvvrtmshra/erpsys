{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "../frontend/dist/**/*",
      "../database/schema.sql",
      ".env"
    ],
    "targets": ["node18-win-x64"],
    "outputPath": "../dist"
  },
  "dependencies": {
    "bcryptjs": "*",
    "connect-pg-simple": "*",
    "cors": "*",
    "dotenv": "*",
    "express": "*",
    "express-session": "*",
    "helmet": "*",
    "morgan": "*",
    "multer": "*",
    "pg": "*"
  }
}
