# Dependencies
node_modules/
**/node_modules/

# Environment variables (never commit secrets/credentials)
.env
.env.local
.env.*.local
**/.env
!.env.example
!**/.env.example

# Build output
frontend/dist/
backend/dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# PM2
.pm2/
pm2.log

# Database
*.sql.bak
database/backups/
*.dump

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Uploaded files (documents, invoices, drawings stored locally — don't commit user data)
backend/uploads/
uploads/

# Testing
coverage/
.nyc_output/

# Vite cache
frontend/.vite/
frontend/node_modules/.vite/

# Electron/pkg build output — all generated, never commit
dist/
installer/
out/

# Electron packaging cache
.webpack/

# Misc
*.tmp
.cache/